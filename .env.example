# Supabase project settings -> API. Never put the service role key in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Google AI Studio. This key is server-only.
GEMINI_API_KEY=your-server-only-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# Must exactly match the browser origin used for sign-in and OAuth.
NEXT_PUBLIC_APP_URL=https://thinkora-new.vercel.app

# Optional: shown on /privacy for support and data-deletion requests.
NEXT_PUBLIC_SUPPORT_EMAIL=support@your-domain.com

# Legacy email settings; direct teacher/student connections do not use these.
RESEND_API_KEY=
EMAIL_FROM=
